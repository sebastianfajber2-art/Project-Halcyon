      "segments": [
        {
          "scene": "s01",
          "start": 0.0,
          "end": 3.0,
          "text": "Iron Man's arc reactor would cook him alive."
        },
        {
          "scene": "s02",
          "start": 3.0,
          "end": 9.0,
          "text": "In the movie it makes three gigajoules every second. From his chest."
        },
        {
          "scene": "s03",
          "start": 9.0,
          "end": 15.0,
          "text": "But no machine is a hundred percent efficient. Even at ninety percent..."
        },
        {
          "scene": "s04",
          "start": 15.0,
          "end": 21.0,
          "text": "...that's three hundred million watts of waste heat. A small power plant, on his ribs."
        },
        {
          "scene": "s05",
          "start": 21.0,
          "end": 25.5,
          "text": "Your body can get rid of about three hundred watts."
        },
        {
          "scene": "s06",
          "start": 25.5,
          "end": 34.0,
          "text": "So I'm building a real flying suit. Rule one: physics wins. Jet turbines instead of a reactor. Wings instead of hovering."
        },
        {
          "scene": "s07",
          "start": 34.0,
          "end": 40.0,
          "text": "Every number is checked. Follow to see if it flies."
        }
      ]
    },
